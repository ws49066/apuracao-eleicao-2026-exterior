# Todas as variáveis são opcionais — os padrões já apontam para o 2º turno de 2026.

# Para rever o 1º turno da Eleição Ordinária Federal de 2026:
# TSE_ELEICAO=6257
# TSE_TURNO=1

# Para testar contra o ambiente de simulado do TSE:
# TSE_BASE=https://resultados-sim.tse.jus.br
# TSE_AMBIENTE=simulado
# TSE_CICLO=simulado2026
